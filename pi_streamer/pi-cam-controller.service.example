[Unit]
Description=MQTT controlled Raspberry Pi camera streamer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Esp32cam
ExecStart=/home/pi/Esp32cam/.venv/bin/python /home/pi/Esp32cam/pi_streamer/pi_cam_controller.py --config /home/pi/Esp32cam/pi_streamer/config.json --autostart
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
